# logfile_fd: It can be disabled by configuration, but typically tiles
#             will open a log file on boot and write all messages there.
#
# grpc_socket_fd: The gRPC tile serves HTTP/2 over plain TCP and does not
#                 use our XDP program.  It uses regular kernel sockets,
#                 so this is the listening socket file descriptor.
uint logfile_fd, uint grpc_socket_fd

# logging: all log messages are written to a file and/or pipe
#
# 'WARNING' and above are written to the STDERR pipe, while all messages
# are always written to the log file.
#
# arg 0 is the file descriptor to write to.  The boot process ensures
# that descriptor 2 is always STDERR and descriptor 4 is the logfile.
write: (or (eq (arg 0) 2)
           (eq (arg 0) logfile_fd))

# logging: 'WARNING' and above fsync the logfile to disk immediately
#
# arg 0 is the file descriptor to fsync.
fsync: (eq (arg 0) logfile_fd)

# server: serving gRPC requires accepting connections
#
# arg 0 is the listen socket file descriptor to accept connections on
accept4: (and (eq (arg 0) grpc_socket_fd)
              (eq (arg 1) 0)
              (eq (arg 2) 0)
              (eq (arg 3) "SOCK_CLOEXEC|SOCK_NONBLOCK"))

# server: each accepted connection disables Nagle so that streamed
#         updates are not delayed waiting for a full segment
#
# arg 0 is the connected socket returned by accept4(2).  arg 1 is the
# level, IPPROTO_TCP, and arg 2 is the option, TCP_NODELAY.
setsockopt: (and (eq (arg 1) IPPROTO_TCP)
                 (eq (arg 2) TCP_NODELAY))

# server: the HTTP/2 client preface is read directly off the socket
#
# arg 0 is the file descriptor to read from.  It can be any of the
# connected client sockets returned by accept4(2).  To accomodate this,
# we allow any file descriptor except those which we know are not these
# connected clients, which are the log file, STDERR, and the listening
# socket itself.
read: (not (or (eq (arg 0) 2)
               (eq (arg 0) logfile_fd)
               (eq (arg 0) grpc_socket_fd)))

# server: HTTP/2 frames are received with scatter-gather reads
#
# arg 0 is the file descriptor to receive from.  It can be any of the
# connected client sockets returned by accept4(2).  To accomodate this,
# we allow any file descriptor except those which we know are not these
# connected clients, which are the log file, STDERR, and the listening
# socket itself.
recvmsg: (not (or (eq (arg 0) 2)
                  (eq (arg 0) logfile_fd)
                  (eq (arg 0) grpc_socket_fd)))

# server: HTTP/2 frames are sent with scatter-gather writes
#
# arg 0 is the file descriptor to send to.  It can be any of the
# connected client sockets returned by accept4(2).  To accomodate this,
# we allow any file descriptor except those which we know are not these
# connected clients, which are the log file, STDERR, and the listening
# socket itself.
sendmsg: (not (or (eq (arg 0) 2)
                  (eq (arg 0) logfile_fd)
                  (eq (arg 0) grpc_socket_fd)))

# server: serving gRPC requires closing connections, and shutting the
#         server down closes the listening socket too
#
# arg 0 is the file descriptor to close.  It can be any of the connected
# client sockets returned by accept4(2), or the listening socket.  To
# accomodate this, we allow any file descriptor except those which we
# know are neither, which are the log file and STDERR.
close: (not (or (eq (arg 0) 2)
                (eq (arg 0) logfile_fd)))

# server: serving gRPC requires polling connections
ppoll